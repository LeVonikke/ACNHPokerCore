<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ACNHPokerCore.Avalonia.App"
             RequestedThemeVariant="Dark">
    <!-- "Dark" matches the original app's default dark WinForms theme. "Default" would
         follow the OS theme instead - see README if you want to switch it later. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
